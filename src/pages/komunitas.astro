---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import PageHero from '../components/PageHero.astro';
import EyebrowTag from '../components/EyebrowTag.astro';
import DecoRidge from '../components/DecoRidge.astro';
import CTAButton from '../components/CTAButton.astro';
import { getCollection, render } from 'astro:content';
import { photoByPartner, photos } from '../utils/photos';

const partnerEntries = await getCollection('partners');

const partners = await Promise.all(
	partnerEntries.map(async (partner) => {
		const { Content } = await render(partner);
		return { data: partner.data, Content };
	}),
);

const benefitModels = [
	{
		title: 'Mata pencaharian berkelanjutan',
		desc: 'Kebun bibit desa, agroforestri, dan hasil hutan non-kayu memberikan penghasilan yang bersambung di luar musim tanam.',
	},
	{
		title: 'Penguatan kapasitas teknis',
		desc: 'Pelatihan pembibitan, penanaman, monitoring, dan pengelolaan hutan memperkuat kemandirian kelompok.',
	},
	{
		title: 'Kepemilikan atas data',
		desc: 'Warga ikut mengumpulkan dan memvalidasi data, sehingga hasil monitoring tidak hanya milik program, tetapi juga komunitas.',
	},
	{
		title: 'Kemitraan jangka panjang',
		desc: 'Perjanjian yang jelas tentang peran, insentif, dan durasi pendampingan — melampaui satu siklus tanam.',
	},
];

const stories = [
	{
		placeholder:
			'Testimoni langsung dari komunitas mitra akan ditampilkan di sini setelah dikumpulkan dari lapangan.',
	},
];
---

<Layout
	title="Komunitas | Yayasan SKALA"
	description="Kelompok Tani Hutan mitra SKALA, model manfaat untuk masyarakat, serta cerita keterlibatan warga dalam program konservasi."
>
	<!-- Hero -->
	<PageHero image={photos.gotongRoyongBudaya} alt="Warga bekerja bersama dalam tradisi gotong royong sebagai media komunikasi dan silaturahmi antarsesama warga" position="center 40%">
		<h1 class="hero-title" data-reveal>
			Komunitas Adalah Pemilik Program
		</h1>
		<p class="hero-lead" data-reveal>
			Program lapangan SKALA dikerjakan bersama Kelompok Tani Hutan (KTH) mitra yang terlibat dalam pemetaan,
			penanaman, dan pemantauan lahan konservasi di Garut.
		</p>
	</PageHero>

	<!-- Profil KTH -->
	<section class="container-skala py-20 lg:py-24" data-reveal-group>
		<EyebrowTag text="KTH Mitra SKALA" />
		<h2 class="mt-6 font-serif text-[30px] font-semibold leading-[1.2] text-olive sm:text-[42px] lg:text-[50px] xl:text-[56px]" data-reveal>
			Kelompok Tani Hutan di tiap kawasan program
		</h2>

		<div class="mt-10 grid gap-8 lg:grid-cols-3">
			{partners.map((partner) => (
				<article class="flex flex-col overflow-hidden rounded-2xl bg-ink-card" data-reveal>
					<div class="relative aspect-[16/9] w-full overflow-hidden bg-ink-raise">
						{photoByPartner[partner.id] ? (
							<Image
								src={photoByPartner[partner.id].image}
								alt={photoByPartner[partner.id].alt}
								width={800}
								height={450}
								loading="lazy"
								decoding="async"
								class="h-full w-full object-cover"
							/>
						) : (
							<div class="grid h-full w-full place-items-center bg-gradient-to-br from-ink-raise via-ink-card to-olive-deep/40">
								<span
									class="grid h-16 w-16 place-items-center rounded-full bg-ink/60 font-serif text-xl text-white/80"
									aria-hidden="true"
								>
									{partner.data.name.split(' ').slice(-2).map((w) => w[0] ?? '').join('').toUpperCase()}
								</span>
							</div>
						)}
					</div>
					<div class="flex flex-1 flex-col p-6">
						<h3 class="font-sans text-[1rem] font-semibold leading-[1.4] sm:text-[1.5rem] text-cream">{partner.data.name}</h3>
						<p class="mt-1 text-xs font-semibold uppercase tracking-[0.16em] text-cream-dim">{partner.data.location}</p>
						<p class="mt-4 text-sm leading-[1.5] text-cream/70">{partner.data.description}</p>
						<div class="mt-5 flex-1 text-sm leading-[1.5] text-cream/60">
							<partner.Content />
						</div>
						{partner.data.established_year && (
							<p class="mt-5 border-t border-ink-rule pt-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-olive-soft">
								Berdiri sejak {partner.data.established_year}
							</p>
						)}
					</div>
				</article>
			))}
		</div>
	</section>

	<!-- Model manfaat -->
	<section class="container-skala py-20 lg:py-24" data-reveal-group>
		<div class="rounded-2xl bg-ink-card p-8 lg:p-12">
			<EyebrowTag text="Model Manfaat" />
			<h2 class="mt-6 font-serif text-[30px] font-semibold leading-[1.2] text-olive sm:text-[42px] lg:text-[50px] xl:text-[56px]" data-reveal>
				Bagaimana program menyejahterakan warga, bukan hanya menghijaukan lahan
			</h2>

			<div class="mt-10 grid gap-6 lg:grid-cols-2">
				{benefitModels.map((benefit) => (
					<div class="rounded-2xl bg-white p-8" data-reveal>
						<h3 class="font-sans text-[1rem] font-semibold leading-[1.4] sm:text-[1.5rem] text-cream">{benefit.title}</h3>
						<p class="mt-2 text-sm leading-[1.5] text-cream/65">{benefit.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Cerita -->
	<section class="container-skala py-20 lg:py-24" data-reveal-group>
		<EyebrowTag text="Cerita dari Lapangan" />
		<h2 class="mt-6 font-serif text-[30px] font-semibold leading-[1.2] text-olive sm:text-[42px] lg:text-[50px] xl:text-[56px]" data-reveal>
			Dampak yang diceritakan langsung oleh mereka yang merawat lahan
		</h2>

		<div class="mt-10 grid gap-6 lg:grid-cols-2">
			{stories.map((story) => (
				<figure class="rounded-2xl bg-ink-card p-8" data-reveal>
					<p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-cream-dim" aria-hidden="true">
						Belum tersedia
					</p>
					<blockquote class="mt-4 text-[15px] leading-[1.5] text-cream/80">
						{story.placeholder}
					</blockquote>
				</figure>
			))}
		</div>
	</section>

	<!-- CTA -->
	<section class="container-skala pb-20" data-reveal>
		<div class="relative flex flex-col items-start justify-between gap-6 overflow-hidden rounded-2xl bg-olive p-8 text-ink sm:flex-row sm:items-center lg:p-12">
			<DecoRidge class="pointer-events-none absolute bottom-0 left-0 w-full" />
			<div class="relative z-10">
				<h2 class="font-sans text-[1rem] font-semibold leading-[1.4] sm:text-[1.5rem] lg:text-3xl">
					Bekerja dengan komunitas adalah kuncinya
				</h2>
				<p class="mt-2 max-w-xl text-sm leading-[1.5] text-ink/75">
					Program kemitraan Anda akan dikelola bersama KTH yang sudah bermitra — dengan perjanjian, safeguard, dan data yang transparan.
				</p>
			</div>
			<CTAButton href="/kemitraan" variant="outline" className="relative z-10 bg-ink text-cream hover:bg-ink-raise hover:text-cream">
				Bermitra dengan Kami
			</CTAButton>
		</div>
	</section>
</Layout>
