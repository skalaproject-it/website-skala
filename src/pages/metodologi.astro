---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import EyebrowTag from '../components/EyebrowTag.astro';
import DecoRidge from '../components/DecoRidge.astro';
import CTAButton from '../components/CTAButton.astro';
import { photos } from '../utils/photos';

const operatingSteps = [
	{
		step: '01',
		title: 'Pemetaan konteks',
		desc: 'Desk study, social mapping, baseline, dan stakeholder map.',
	},
	{
		step: '02',
		title: 'Perancangan partisipatif',
		desc: 'Tujuan, theory of change, indikator, rencana kerja, dan mitigasi risiko.',
	},
	{
		step: '03',
		title: 'Mobilisasi kolaborasi',
		desc: 'Pembagian peran, komunikasi, kemitraan lokal, dan kesiapan pelaksanaan.',
	},
	{
		step: '04',
		title: 'Implementasi & pendampingan',
		desc: 'Fasilitasi, pelatihan, penguatan organisasi, dan problem solving adaptif.',
	},
	{
		step: '05',
		title: 'Evaluasi & komunikasi',
		desc: 'Monitoring, refleksi, rekomendasi, laporan, presentasi, dan publikasi dampak.',
	},
];

const workPrinciples = [
	{
		title: 'Partisipatif',
		desc: 'Keputusan program mempertimbangkan suara dan kapasitas kelompok sasaran.',
	},
	{
		title: 'Berbasis bukti',
		desc: 'Analisis dan rekomendasi ditopang oleh data, observasi, dan dokumentasi.',
	},
	{
		title: 'Inklusif',
		desc: 'Proses memperhatikan kelompok rentan, kesetaraan akses, dan dinamika lokal.',
	},
	{
		title: 'Akuntabel',
		desc: 'Peran, keluaran, indikator, dan perubahan terdokumentasi secara transparan.',
	},
	{
		title: 'Berkelanjutan',
		desc: 'Program diarahkan pada penguatan kapasitas dan mekanisme pascapendampingan.',
	},
];

const qualityGates = ['Scope alignment', 'Data validation', 'Stakeholder review', 'Editorial & visual QA'];

const capabilityGroups = [
	{
		code: 'SE',
		title: 'Strategy & ESG',
		roles: [
			{
				name: 'Sustainability Consultant',
				desc: 'Menyelaraskan tujuan program, isu material, pemangku kepentingan, dan arah keberlanjutan.',
			},
			{
				name: 'ESG Communication Specialist',
				desc: 'Menyusun narasi ESG yang jelas, konsisten, dan berbasis bukti.',
			},
		],
	},
	{
		code: 'RP',
		title: 'Reporting & Publication',
		roles: [
			{
				name: 'Sustainability Report Designer',
				desc: 'Merancang laporan keberlanjutan yang informatif dan konsisten dengan identitas organisasi.',
			},
			{
				name: 'Corporate Publication Designer',
				desc: 'Mendesain publikasi korporat yang selaras dengan identitas dan pesan organisasi.',
			},
			{
				name: 'Annual Report Expert',
				desc: 'Mengelola struktur dan penyajian laporan tahunan secara runtut, akurat, dan profesional.',
			},
		],
	},
	{
		code: 'CL',
		title: 'Creative Leadership',
		roles: [
			{
				name: 'Senior Presentation Designer',
				desc: 'Menyusun presentasi eksekutif yang padat, visual, dan persuasif.',
			},
			{
				name: 'Creative Director',
				desc: 'Mengarahkan arah visual dan narasi agar konsisten lintas kanal komunikasi.',
			},
			{
				name: 'Sustainability Report Art Director',
				desc: 'Memimpin bahasa visual laporan keberlanjutan yang kredibel dan berkarakter.',
			},
		],
	},
];
---

<Layout
	title="Metodologi & Sains | SKALA"
	description="Operating model SKALA: dari pemetaan konteks, perancangan partisipatif, mobilisasi kolaborasi, hingga evaluasi dan komunikasi dampak dengan standar kerja dan quality assurance."
>
	<!-- Hero -->
	<PageHero image={photos.ukurPohon} alt="Peneliti mengukur batang pohon dengan meteran di dalam plot hutan" position="center 35%">
		<h1 class="hero-title" data-reveal>
			Operating Model: Dari Konteks Menuju Dampak
		</h1>
		<p class="hero-lead" data-reveal>
			Model kerja SKALA menjaga kesinambungan antara analisis sosial, desain program, pelaksanaan lapangan,
			evaluasi, dan komunikasi dampak.
		</p>
	</PageHero>

	<!-- Operating Model -->
	<section class="container-skala py-20 lg:py-24" data-reveal-group>
		<EyebrowTag text="Operating Model" />
		<h2 class="mt-6 font-serif text-[30px] font-semibold leading-[1.2] text-olive sm:text-[42px] lg:text-[50px] xl:text-[56px]" data-reveal>
			Lima langkah kerja SKALA
		</h2>

		<ol class="relative mt-12 ml-5 border-l border-ref-line">
			{operatingSteps.map((item, index) => {
				const last = index === operatingSteps.length - 1;
				return (
					<li class:list={['relative pb-12 pl-12 last:pb-0', { 'sm:pb-14': last }]} data-reveal>
						<span
							class:list={[
								'absolute left-0 top-0 grid h-11 w-11 -translate-x-1/2 place-items-center rounded-full font-serif text-sm font-semibold',
								last
									? 'bg-olive text-ink shadow-lg shadow-olive/25'
									: 'border border-white/20 bg-ink-deep text-white/80',
							]}
						>
							{item.step}
						</span>
						<div>
							<h3 class:list={['font-serif text-2xl font-semibold tracking-tight', last ? 'text-olive-soft' : 'text-cream']}>
								{item.title}
							</h3>
							<p class="mt-2 max-w-2xl text-sm leading-[1.5] text-cream/65">{item.desc}</p>
						</div>
					</li>
				);
			})}
		</ol>
	</section>

	<!-- Standar Kerja & Quality Assurance -->
	<section class="container-skala py-20 lg:py-24" data-reveal-group>
		<div class="rounded-2xl bg-ink-card p-8 lg:p-12">
			<EyebrowTag text={'Standar Kerja & Quality Assurance'} />
			<h2 class="mt-6 font-serif text-[30px] font-semibold leading-[1.2] text-olive sm:text-[42px] lg:text-[50px] xl:text-[56px]" data-reveal>
				Kontrol mutu di setiap tahap penugasan
			</h2>
			<p class="mt-4 max-w-3xl text-sm leading-[1.5] text-cream/65" data-reveal>
				Setiap penugasan dikelola melalui ruang lingkup yang jelas, validasi data, review pemangku kepentingan,
				serta kontrol mutu sebelum dokumen atau program diserahkan.
			</p>

			<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{workPrinciples.map((item, index) => (
					<div class="rounded-2xl bg-white p-7" data-reveal>
						<span class="font-serif text-3xl font-semibold tabular-nums text-olive-soft/70">
							{String(index + 1).padStart(2, '0')}
						</span>
						<h3 class="mt-4 font-sans text-[1rem] font-semibold leading-[1.4] sm:text-[1.5rem] text-cream">{item.title}</h3>
						<p class="mt-2 text-sm leading-[1.5] text-cream/65">{item.desc}</p>
					</div>
				))}
				<div class="rounded-2xl bg-olive/10 p-7" data-reveal>
					<p class="font-serif text-xl text-olive-soft">Quality gates</p>
					<div class="mt-4 flex flex-wrap items-center gap-2">
						{qualityGates.map((gate, index) => (
							<>
								<span class="rounded-full border border-white/20 bg-ink-deep px-3.5 py-1.5 text-xs font-semibold text-white/80">
									{gate}
								</span>
								{index < qualityGates.length - 1 && (
									<svg class="h-3.5 w-3.5 text-white/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M5 12h14" />
										<path d="m12 5 7 7-7 7" />
									</svg>
								)}
							</>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Kapabilitas Program & Kemitraan -->
	<section class="container-skala py-20 lg:py-24" data-reveal-group>
		<EyebrowTag text="Kapabilitas" />
		<h2 class="mt-6 font-serif text-[30px] font-semibold leading-[1.2] text-olive sm:text-[42px] lg:text-[50px] xl:text-[56px]" data-reveal>
			Kapabilitas Program &amp; Kemitraan
		</h2>
		<p class="mt-4 max-w-3xl text-sm leading-[1.5] text-cream/65" data-reveal>
			SKALA menghadirkan kapabilitas penuh untuk mendampingi organisasi dari perencanaan strategis hingga
			penyajian publik yang berdampak.
		</p>

		<div class="mt-12 grid gap-6 lg:grid-cols-3">
			{capabilityGroups.map((group) => (
				<div class="flex flex-col rounded-2xl bg-ink-card p-8" data-reveal>
					<span class="grid h-12 w-12 place-items-center rounded-full bg-olive/15 font-serif text-lg font-bold text-olive-soft">
						{group.code}
					</span>
					<h3 class="mt-6 font-sans text-[1rem] font-semibold leading-[1.4] text-cream sm:text-[1.5rem]">{group.title}</h3>
					<ul class="mt-6 space-y-5">
						{group.roles.map((role) => (
							<li>
								<h4 class="text-[1.125rem] font-semibold leading-[1.4] text-cream">{role.name}</h4>
								<p class="mt-1 text-sm leading-[1.5] text-cream/60">{role.desc}</p>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>

		<div class="relative mt-12 flex flex-col items-start justify-between gap-6 overflow-hidden rounded-2xl bg-olive p-8 text-ink sm:flex-row sm:items-center lg:p-10" data-reveal>
			<DecoRidge class="pointer-events-none absolute bottom-0 left-0 w-full" />
			<div class="relative z-10">
				<h3 class="font-sans text-[1rem] font-semibold leading-[1.4] sm:text-[1.5rem]">
					Ingin mendiskusikan kebutuhan program Anda?
				</h3>
				<p class="mt-2 max-w-xl text-sm leading-[1.5] text-ink/75">
					Tim SKALA siap menyusun pendekatan yang sesuai dengan konteks, kapasitas, dan target dampak organisasi.
				</p>
			</div>
			<CTAButton href="/kemitraan" variant="outline" className="relative z-10 bg-ink text-cream hover:bg-ink-raise hover:text-cream">
				Mulai Percakapan
			</CTAButton>
		</div>
	</section>
</Layout>