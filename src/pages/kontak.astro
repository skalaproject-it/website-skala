---
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';
import PageHero from '../components/PageHero.astro';
import DecoRidge from '../components/DecoRidge.astro';
import EyebrowTag from '../components/EyebrowTag.astro';
import { photos } from '../utils/photos';

/* Hanya NAP yang sudah terverifikasi. Tidak ada jam operasional, nama staf,
   atau detail tambahan di halaman ini. */
const orgName = 'Yayasan Studi Komunitas Alamiah (SKALA)';
const email = 'office@skalapro.or.id';
const phoneLabel = '0878-7863-8940';
const phoneWa = '6287878638940';
const streetAddress = 'Jl. Panawuan No. 5A, Kel. Sukajaya, Kec. Tarogong Kidul, Kab. Garut, Jawa Barat 44152';

/* Peta memakai pencarian berbasis alamat teks (query), bukan titik lat/long.
   Koordinat GPS tidak pernah dikonfirmasi, jadi tidak di-hardcode.

   Query peta memakai bentuk alamat panjang tanpa singkatan, karena Google Maps
   lebih mudah mencocokkannya ke data lokasi yayasan sehingga nama yayasan
   muncul di panel peta. Alamat yang ditampilkan ke pengunjung tetap bentuk
   ringkas yang sama dengan Footer. */
const mapAddress = 'Jl. Panawuan No. 5A, Kelurahan Sukajaya, Kecamatan Tarogong Kidul, Garut 44152';
const mapQuery = encodeURIComponent(mapAddress);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&output=embed`;

/* Opsi topik. "Kemitraan" sengaja tidak ada: pengajuan kemitraan formal
   ditangani formulir khusus di /kemitraan. */
const topics = [
	{ value: 'Pertanyaan Umum', label: 'Pertanyaan Umum' },
	{ value: 'Media/Publikasi', label: 'Media / Publikasi' },
	{ value: 'Permintaan Dokumen', label: 'Permintaan Dokumen' },
	{ value: 'Lainnya', label: 'Lainnya' },
];

const pageTitle = 'Kontak — SKALA | Yayasan Studi Komunitas Alamiah, Garut';
const pageDescription =
	'Hubungi Yayasan Studi Komunitas Alamiah (SKALA) di Garut, Jawa Barat — email office@skalapro.or.id atau telepon 0878-7863-8940.';

const contactPageSchema = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	name: 'Kontak SKALA',
	url: 'https://skalapro.or.id/kontak',
};

/* og:image memakai foto hero halaman ini, dioptimasi ke rasio Open Graph 1200x630. */
const ogImage = await getImage({
	src: photos.kanopiAerial,
	width: 1200,
	height: 630,
	fit: 'cover',
	format: 'jpeg',
});
const ogImageUrl = new URL(ogImage.src, Astro.site).toString();
---

<Layout title={pageTitle} description={pageDescription} image={ogImageUrl}>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(contactPageSchema)} is:inline />

	<!-- Hero -->
	<PageHero
		image={photos.kanopiAerial}
		alt="Pemandangan aerial kanopi hutan yang rimbun"
		position="center 40%"
	>
		<h1 class="hero-title" data-reveal>
			Hubungi Kami
		</h1>
		<p class="hero-lead" data-reveal>
			Untuk pertanyaan umum, kolaborasi program, atau permintaan dokumen resmi, silakan hubungi kami melalui
			kontak di bawah atau isi formulir.
		</p>
	</PageHero>

	<!-- Informasi kontak -->
	<section class="container-skala py-14 lg:py-[120px]">
		<div class="flex flex-col gap-12 lg:gap-[48px]" data-reveal-group>
			<div class="flex w-full flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
				<div class="flex flex-col gap-4" data-reveal>
					<EyebrowTag text="Kontak" />
					<h2 class="font-serif text-[30px] font-semibold leading-[1.2] text-olive sm:text-[38px] lg:text-[50px]">
						Informasi Kontak
					</h2>
				</div>
				<p class="max-w-md text-sm font-light leading-[1.5] text-cream-dim sm:text-right lg:text-base" data-reveal>
					Jangkau kami melalui kanal di bawah ini.
				</p>
			</div>

			<div class="overflow-hidden rounded-2xl border border-black/5 bg-ink-card" data-reveal>
				<iframe
					title={`Peta lokasi kantor SKALA — ${mapAddress}`}
					src={mapEmbed}
					class="h-[230px] w-full border-0 sm:h-[300px] lg:h-[420px]"
					loading="lazy"
				></iframe>
			</div>

			<address class="not-italic" data-reveal>
				<p class="text-sm font-semibold text-cream">{orgName}</p>
				<p class="mt-1 text-sm font-light leading-[1.5] text-cream-dim">{streetAddress}</p>
			</address>

			<div class="flex flex-col gap-3 lg:flex-row lg:gap-10" data-reveal-group>
				<a
					href={`https://wa.me/${phoneWa}`}
					class="group flex min-w-0 items-center gap-6 rounded-2xl bg-ink-card p-4 pr-6 transition-colors duration-300 hover:bg-ink-raise lg:min-w-[300px]"
					data-reveal
				>
					<span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-olive text-ink">
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z" />
						</svg>
					</span>
					<span class="flex min-w-0 flex-col gap-1.5">
						<span class="text-sm font-light text-cream-dim">Telepon / WhatsApp</span>
						<span class="font-serif text-lg font-semibold leading-snug text-cream">{phoneLabel}</span>
					</span>
				</a>

				<div class="flex min-w-0 flex-1 items-center gap-6 rounded-2xl bg-ink-card p-4 pr-6" data-reveal>
					<span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-olive text-ink">
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
							<circle cx="12" cy="10" r="3" />
						</svg>
					</span>
					<span class="flex min-w-0 flex-col gap-1.5">
						<span class="text-sm font-light text-cream-dim">Alamat</span>
						<address class="font-serif text-lg font-semibold leading-snug text-cream not-italic">
							{streetAddress}
						</address>
					</span>
				</div>

				<a
					href={`mailto:${email}`}
					class="group flex min-w-0 items-center gap-6 rounded-2xl bg-ink-card p-4 pr-6 transition-colors duration-300 hover:bg-ink-raise lg:min-w-[300px]"
					data-reveal
				>
					<span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-olive text-ink">
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="2" y="4" width="20" height="16" rx="2" />
							<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
						</svg>
					</span>
					<span class="flex min-w-0 flex-col gap-1.5">
						<span class="text-sm font-light text-cream-dim">Email</span>
						<span class="truncate font-serif text-lg font-semibold leading-snug text-cream">{email}</span>
					</span>
				</a>
			</div>
		</div>
	</section>

	<!-- Form -->
	<section id="contact-form-section" class="container-skala pb-14 lg:pb-[120px]">
		<div
			class="relative flex w-full flex-col items-center gap-12 overflow-hidden rounded-2xl bg-olive p-5 sm:p-10"
			data-reveal-group
		>
			<DecoRidge class="pointer-events-none absolute bottom-0 left-0 w-full" />
			<div class="relative z-10 flex flex-col items-center gap-4 text-center" data-reveal>
				<EyebrowTag tone="dark" text="KONTAK KAMI" />
				<h2 class="font-serif text-[30px] font-semibold leading-[1.2] text-ink sm:text-[38px] lg:text-[50px]">
					Kirim Pesan
				</h2>
				<p class="max-w-xl text-sm leading-[1.5] text-ink/75">
					Formulir ini untuk pertanyaan umum. Untuk pengajuan kemitraan formal, gunakan formulir khusus
					yang menanyakan jenis kolaborasi, lokasi, dan rencana program yang diminati.
				</p>
			</div>

			<div class="relative z-10 w-full max-w-[680px] rounded-2xl bg-ink-card p-5 sm:p-10">
				<form data-contact-form novalidate class="flex w-full flex-col gap-6">
					<div class="flex flex-col gap-6 sm:flex-row sm:gap-6">
						<div class="w-full">
							<label for="contact-name" class="mb-2 block text-base font-semibold text-cream">Nama</label>
							<input
								id="contact-name"
								name="name"
								type="text"
								required
								autocomplete="name"
								placeholder="Nama Anda"
								class="h-[50px] w-full rounded-2xl border border-black/5 bg-white px-4 text-sm text-cream placeholder:text-cream-faint transition-colors focus:border-olive-soft/60 focus:outline-none focus:ring-2 focus:ring-olive-soft/40"
							/>
						</div>
						<div class="w-full">
							<label for="contact-email" class="mb-2 block text-base font-semibold text-cream">Email</label>
							<input
								id="contact-email"
								name="email"
								type="email"
								required
								autocomplete="email"
								placeholder="nama@contoh.id"
								class="h-[50px] w-full rounded-2xl border border-black/5 bg-white px-4 text-sm text-cream placeholder:text-cream-faint transition-colors focus:border-olive-soft/60 focus:outline-none focus:ring-2 focus:ring-olive-soft/40"
							/>
						</div>
					</div>

					<div class="w-full">
						<label for="contact-topic" class="block text-base font-semibold text-cream">Topik</label>
						<div class="relative mt-2">
							<select
								id="contact-topic"
								name="subject"
								required
								class="h-[50px] w-full appearance-none rounded-2xl border border-black/5 bg-white pr-10 pl-4 text-sm text-cream transition-colors focus:border-olive-soft/60 focus:outline-none focus:ring-2 focus:ring-olive-soft/40"
							>
								<option value="" selected disabled>Pilih topik…</option>
								{topics.map((topic) => (
									<option value={topic.value} class="text-cream">{topic.label}</option>
								))}
							</select>
							<svg
								class="pointer-events-none absolute inset-y-0 right-4 my-auto h-4 w-4 text-cream/60"
								viewBox="0 0 16 16"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="m3 6 5 5 5-5" />
							</svg>
						</div>
					</div>

					<div>
						<label for="contact-message" class="mb-2 block text-base font-semibold text-cream">Pesan</label>
						<textarea
							id="contact-message"
							name="message"
							rows={5}
							required
							placeholder="Tuliskan pesan Anda di sini"
							class="min-h-[120px] w-full resize-y rounded-2xl border border-black/5 bg-white px-4 py-3 text-sm leading-[1.5] text-cream placeholder:text-cream-faint transition-colors focus:border-olive-soft/60 focus:outline-none focus:ring-2 focus:ring-olive-soft/40"
						></textarea>
					</div>

					{/* Saran ke form kemitraan: muncul bila pesan menyebut kata kunci
					    kemitraan/pendanaan, karena topik "Kemitraan" tidak ada di sini. */}
					<p
						data-partnership-hint
						class="hidden rounded-2xl bg-ink-raise px-4 py-3 text-sm leading-[1.5] text-cream"
						aria-live="polite"
					>
						Untuk pengajuan kemitraan formal, formulir di
						<a href="/kemitraan" class="font-semibold text-olive-soft underline">halaman kemitraan</a>
						lebih lengkap: menanyakan jenis kolaborasi, organisasi, dan lokasi yang diminati.
					</p>

					<button
						type="submit"
						data-contact-submit
						class="h-[50px] w-full rounded-full bg-olive font-semibold text-ink transition-colors duration-200 hover:bg-olive-deep disabled:cursor-not-allowed disabled:opacity-60"
					>
						Kirim Pesan
					</button>

					<p data-contact-status class="hidden rounded-2xl bg-ink-raise px-4 py-3 text-sm leading-[1.5]"></p>
				</form>

				<div data-contact-success class="hidden py-6 text-center">
					<span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-olive text-ink">
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M20 6 9 17l-5-5" />
						</svg>
					</span>
					<h3 class="mt-5 font-sans text-[1rem] font-semibold leading-[1.4] sm:text-[1.5rem] text-cream">Pesan terkirim</h3>
					<p class="mx-auto mt-2 max-w-sm text-sm leading-[1.5] text-cream/65">
						Terima kasih. Pesan Anda sudah kami terima dan akan dibalas melalui email.
					</p>
					<button type="button" data-contact-reset class="mt-6 text-sm font-semibold text-olive-soft hover:underline">
						Kirim pesan lain
					</button>
				</div>
			</div>

			<p class="relative z-10 max-w-xl text-center text-sm leading-[1.5] text-ink/75">
				Tertuju pada kemitraan, investasi, atau kerja sama program? Gunakan
				<a href="/kemitraan" class="font-semibold text-ink underline">formulir kemitraan</a> agar jenis
				kolaborasi dan kawasan yang Anda minati tercatat lengkap.
			</p>
		</div>
	</section>
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
	const statusEl = document.querySelector<HTMLElement>('[data-contact-status]');
	const successEl = document.querySelector<HTMLElement>('[data-contact-success]');
	const submitBtn = document.querySelector<HTMLButtonElement>('[data-contact-submit]');
	const messageEl = document.querySelector<HTMLTextAreaElement>('#contact-message');
	const partnershipHint = document.querySelector<HTMLElement>('[data-partnership-hint]');

	const setStatus = (message: string, tone: 'error' | 'success'): void => {
		if (!statusEl) return;
		statusEl.textContent = message;
		statusEl.classList.remove('hidden', 'text-red-300', 'text-olive-soft');
		statusEl.classList.add(tone === 'error' ? 'text-red-300' : 'text-olive-soft');
	};

	/* Kata kunci yang menandakan pesan sebenarnya pengajuan kemitraan, sehingga
	   pengunjung diarahkan ke formulir khusus yang menanyakan detail skema. */
	const partnershipPattern =
		/(kemitraan|mitra\b|kolaborasi|kerja\s?sama|pendanaan|investasi|investor|sponsor|csr|tjsl|pendonor|hibah)/i;
	const syncPartnershipHint = (): void => {
		if (!messageEl || !partnershipHint) return;
		partnershipHint.classList.toggle('hidden', !partnershipPattern.test(messageEl.value));
	};
	messageEl?.addEventListener('input', syncPartnershipHint);

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!form || !submitBtn) return;
		submitBtn.disabled = true;
		submitBtn.textContent = 'Mengirim…';
		setStatus('', 'success');

		const payload = Object.fromEntries(new FormData(form));
		try {
			const res = await fetch('/api/kontak', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});
			const data = (await res.json().catch(() => ({ message: 'Terjadi kesalahan. Coba lagi.' }))) as {
				message?: string;
			};
			if (res.ok) {
				form.classList.add('hidden');
				successEl?.classList.remove('hidden');
			} else {
				setStatus(data.message ?? 'Gagal mengirim. Coba lagi.', 'error');
			}
		} catch {
			setStatus('Koneksi bermasalah. Periksa jaringan lalu coba lagi.', 'error');
		} finally {
			submitBtn.disabled = false;
			submitBtn.textContent = 'Kirim Pesan';
		}
	});

	document.querySelector<HTMLButtonElement>('[data-contact-reset]')?.addEventListener('click', () => {
		form?.reset();
		form?.classList.remove('hidden');
		successEl?.classList.add('hidden');
		partnershipHint?.classList.add('hidden');
		setStatus('', 'success');
	});
</script>
