---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import CTAButton from '../components/CTAButton.astro';
import EyebrowTag from '../components/EyebrowTag.astro';
import PartnerLogoStrip from '../components/PartnerLogoStrip.astro';
import DecoRidge from '../components/DecoRidge.astro';
import { photoByProject } from '../utils/photos';
import { sortNews } from '../utils/news';

const publicPartnersDir = join(process.cwd(), 'public', 'partners');
const partnerFiles = [
	{ name: 'PT PLN Indonesia Power UBP Kamojang', file: 'pln-indonesia-power.png' },
	{
		name: 'Pusdi CSR FISIP Universitas Padjadjaran',
		file: 'pusdi-csr-fisip-unpad.png',
		logoClass: 'h-9 w-auto max-w-[260px] object-contain',
	},
	{ name: 'BKKBN', file: 'bkkbn.png', logoClass: 'h-10 max-w-[170px] object-contain' },
];
const partners = partnerFiles.map(({ file, ...partner }) => ({
	...partner,
	src: existsSync(join(publicPartnersDir, file)) ? `/partners/${file}` : undefined,
}));

const programCards = [
	{
		title: 'Pemberdayaan Masyarakat',
		desc: 'Pendampingan kelompok tani, perempuan, pemuda, dan UMKM untuk memperkuat keterampilan serta ekonomi lokal.',
		icon: '<circle cx="9" cy="8" r="3.2" /><path d="M3.5 20v-1.2A4.8 4.8 0 0 1 8.3 14h1.4a4.8 4.8 0 0 1 4.8 4.8V20" /><path d="M16.5 5.2a3.2 3.2 0 0 1 0 5.6" /><path d="M18 14.2a4.8 4.8 0 0 1 3 4.5V20" />',
	},
	{
		title: 'Pelestarian Lingkungan',
		desc: 'Konservasi air dan tanah, rehabilitasi lahan, serta edukasi lingkungan bersama masyarakat.',
		icon: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" /><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />',
	},
	{
		title: 'Kemitraan CSR/TJSL',
		desc: 'Perancangan, pelaksanaan, dan evaluasi program tanggung jawab sosial perusahaan sesuai kebutuhan lapangan.',
		icon: '<path d="M12 21v-4" /><path d="M8.5 17c-2.2 0-4-1.6-4-3.6 0-.9.7-1.6 1.6-1.6.7 0 1.3.4 1.5 1l.5 1.2V6.5a1.5 1.5 0 0 1 3 0V13" /><path d="M13.1 13.4V4.5a1.5 1.5 0 0 1 3 0v8.9" /><path d="M16.1 13.4V7.5a1.5 1.5 0 0 1 3 0v6.9c0 3.3-2.7 6-6 6h-1" />',
	},
	{
		title: 'Riset & Advokasi',
		desc: 'Pemetaan sosial, studi komunitas, dan rekomendasi berbasis data untuk mendukung keputusan program.',
		icon: '<circle cx="10.5" cy="10.5" r="6" /><path d="M20.5 20.5 16 16" /><path d="M8 12.2 10 9.6l1.6 1.7L13.4 8" />',
	},
];

const projects = await getCollection('projects');
const showcaseOrder = ['pln-kamojang-darajat', 'pln-kamojang-ulubelu', 'garut'];
const showcase = showcaseOrder
	.map((id) => projects.find((project) => project.id === id))
	.filter((project): project is (typeof projects)[number] => Boolean(project));
const statusLabels: Record<string, string> = {
	planned: 'Direncanakan',
	active: 'Berjalan',
	completed: 'Selesai',
	fundraising: 'Mencari Mitra Pendanaan',
};
const news = sortNews(await getCollection('news')).slice(0, 3);
const statItems = [
	{ value: 20, suffix: '+', label: 'Tahun mendampingi komunitas' },
	{ value: 13, suffix: '+', label: 'Program terdokumentasi lintas wilayah' },
	{ value: 4, suffix: '', label: 'Pilar kapabilitas program' },
];
---

<Layout
	title="SKALA — Yayasan Studi Komunitas Alamiah | Pemberdayaan Masyarakat & CSR Garut"
	description="Yayasan SKALA mendampingi perusahaan, lembaga, dan komunitas merancang serta menjalankan program pemberdayaan masyarakat, pelestarian lingkungan, dan CSR/TJSL."
	image="/assets/hero.avif"
>
	<!-- Pembuka: identitas, peran, dan dua jalur pengunjung. -->
	<section class="relative flex min-h-[85svh] items-end overflow-hidden bg-ink-deep" aria-labelledby="home-title">
		<div class="absolute inset-0">
			<img
				src="/assets/hero.avif"
				alt="Kawasan hutan yang menjadi wilayah kerja konservasi Yayasan Studi Komunitas Alamiah (SKALA) di Jawa Barat"
				width="1920" height="1080" loading="eager" decoding="async" fetchpriority="high"
				class="absolute inset-0 h-full w-full object-cover object-top"
			/>
			<div class="absolute inset-0 bg-gradient-to-t from-ink-deep via-ink-deep/55 to-ink-deep/10" aria-hidden="true"></div>
		</div>
		<div class="container-skala relative w-full pb-12 pt-32 sm:pb-16 lg:pb-20">
			<div class="flex max-w-[960px] flex-col items-start gap-6" data-hero-drop data-reveal-group>
				<p class="flex items-center gap-3 text-sm font-semibold tracking-wide text-white/90" data-reveal><span class="h-2 w-2 shrink-0 rounded-full bg-brand-gold" aria-hidden="true"></span>Yayasan Studi Komunitas Alamiah</p>
				<h1 id="home-title" class="font-serif text-[36px] font-semibold leading-[1.12] text-white sm:text-[52px] lg:text-[68px] xl:text-[76px]" data-reveal>
					Menguatkan Komunitas,<br /> Merawat Alam.
				</h1>
				<p class="max-w-[680px] text-base leading-relaxed text-white/90 sm:text-lg" data-reveal>
					SKALA adalah mitra pelaksana program pemberdayaan masyarakat, pelestarian lingkungan,
					dan CSR/TJSL. Kami bekerja bersama perusahaan, lembaga, dan komunitas.
				</p>
				<div class="flex flex-wrap items-center gap-x-8 gap-y-4 pt-2" data-reveal>
					<CTAButton href="/kemitraan" variant="hero">Bermitra dengan Kami</CTAButton>
					<a href="#program-unggulan" class="inline-flex min-h-11 items-center gap-3 font-semibold text-white underline decoration-white/50 underline-offset-8 hover:decoration-white">
						Jelajahi Program <span aria-hidden="true">↓</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Profil singkat, pengalaman, dan mitra dalam satu bagian. -->
	<section class="container-skala py-16 lg:py-20" aria-labelledby="tentang-title">
		<div class="grid gap-10 lg:grid-cols-2 lg:gap-16" data-reveal-group>
			<div data-reveal>
				<EyebrowTag text="Tentang SKALA" />
				<h2 id="tentang-title" class="mt-5 font-serif text-3xl font-semibold leading-tight text-cream sm:text-4xl">Berakar di komunitas, bekerja bersama mitra.</h2>
				<p class="mt-5 max-w-xl text-base leading-relaxed text-cream-dim">
					Berbasis di Garut, Jawa Barat, SKALA adalah organisasi nirlaba yang mendampingi masyarakat
					sejak awal 2000-an. Kami merancang program bersama warga, dari pemetaan kebutuhan hingga pendampingan lapangan.
				</p>
				<a href="/tentang" class="mt-5 inline-flex min-h-11 items-center gap-2 font-semibold text-olive hover:underline">Kenali SKALA <span aria-hidden="true">↗</span></a>
			</div>
			<dl class="grid grid-cols-3 gap-4 self-center border-y border-ink-rule py-8 sm:gap-6" data-reveal>
				{statItems.map((stat) => (
					<div class="flex flex-col gap-3">
						<dt class="order-2 text-sm leading-relaxed text-cream-dim">{stat.label}</dt>
						<dd class="font-serif text-4xl font-semibold text-olive sm:text-5xl"><span data-count-up data-count-to={stat.value} data-count-suffix={stat.suffix}>{stat.value}{stat.suffix}</span></dd>
					</div>
				))}
			</dl>
		</div>
		<div class="mt-10 grid items-center gap-6 border-t border-ink-rule pt-8 lg:grid-cols-[180px_minmax(0,1fr)]">
			<p class="text-sm font-semibold text-cream-dim">Bersama mitra kami</p>
			<div class="min-w-0"><PartnerLogoStrip partners={partners} logoTone="full" /></div>
		</div>
	</section>

	<!-- Empat bidang kerja dalam kartu ringkas. -->
	<section class="container-skala pb-16 lg:pb-20" aria-labelledby="pilar-title">
		<div class="flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-end" data-reveal-group>
			<div data-reveal>
				<EyebrowTag text="Bidang Kerja" />
				<h2 id="pilar-title" class="mt-5 font-serif text-3xl font-semibold leading-tight text-olive sm:text-4xl lg:text-5xl">Empat fokus pendampingan.</h2>
			</div>
			<a href="/metodologi" class="inline-flex min-h-11 shrink-0 items-center gap-2 font-semibold text-olive hover:underline">Pelajari cara kerja kami <span aria-hidden="true">↗</span></a>
		</div>
		<div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4" data-reveal-group>
			{programCards.map((card) => (
				<article class="rounded-2xl border border-ink-rule bg-white p-6 lg:p-7" data-reveal>
					<span class="grid h-12 w-12 place-items-center rounded-2xl bg-ink-card text-olive" aria-hidden="true">
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={card.icon}></svg>
					</span>
					<h3 class="mt-6 text-xl font-semibold leading-snug text-cream">{card.title}</h3>
					<p class="mt-3 text-base leading-relaxed text-cream-dim">{card.desc}</p>
				</article>
			))}
		</div>
	</section>

	<!-- Ringkasan program; uraian dan data lengkap tersedia di halaman detail. -->
	<section id="program-unggulan" class="container-skala scroll-mt-28 pb-16 lg:pb-20" aria-labelledby="program-title">
		<div class="rounded-2xl bg-ref-panel p-6 sm:p-8 lg:p-10">
			<div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end" data-reveal-group>
				<div data-reveal>
					<EyebrowTag text="Program Unggulan" />
					<h2 id="program-title" class="mt-5 font-serif text-3xl font-semibold leading-tight text-olive sm:text-4xl lg:text-5xl">Dari rencana ke lapangan.</h2>
				</div>
				<CTAButton href="/program" variant="outline">Lihat Semua Program</CTAButton>
			</div>
			<div class="mt-8 grid gap-8 lg:grid-cols-3" data-reveal-group>
				{showcase.map((project) => {
					const d = project.data;
					const photo = photoByProject[project.id];
					return (
						<article class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-ink-rule bg-white" data-reveal>
							<div class="relative aspect-[4/3] overflow-hidden bg-ink-raise">
								{photo && <Image src={photo.image} alt={photo.alt} width={800} height={500} loading="lazy" decoding="async" class="h-full w-full object-cover" />}
							</div>
							<div class="flex flex-1 flex-col p-5 sm:p-6">
							<p class="self-start rounded-full bg-ink-card px-3 py-1 text-xs font-semibold text-olive">{statusLabels[d.status] ?? d.status}</p>
							<h3 class="mt-2 text-xl font-semibold leading-snug text-cream">{d.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-cream-dim">{d.location}</p>
							<p class="mb-5 mt-3 text-base leading-relaxed text-cream-dim">{d.excerpt}</p>
							<a href={`/program/${project.id}`} aria-label={`Lihat program ${d.title}`} class="mt-auto inline-flex min-h-11 items-center gap-2 self-start font-semibold text-olive hover:underline">Lihat Program <span aria-hidden="true">↗</span></a>
							</div>
						</article>
					);
				})}
			</div>
		</div>
	</section>

	<!-- Berita menjadi jalur lanjutan untuk mengenali kegiatan SKALA. -->
	{news.length > 0 && (
		<section class="container-skala pb-16 lg:pb-20" aria-labelledby="berita-title">
			<div class="flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-end" data-reveal-group>
				<div data-reveal>
					<EyebrowTag text="Cerita dari Lapangan" />
					<h2 id="berita-title" class="mt-5 font-serif text-3xl font-semibold leading-tight text-olive sm:text-4xl lg:text-5xl">Kabar dari komunitas.</h2>
				</div>
				<a href="/berita" class="inline-flex min-h-11 shrink-0 items-center gap-2 font-semibold text-brand-teal hover:underline">Lihat Semua Berita <span aria-hidden="true">↗</span></a>
			</div>
			<div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3" data-reveal-group>
				{news.map((item) => (
					<a href={`/berita/${item.id}`} class="group flex flex-col border-b border-ink-rule pb-5" data-reveal>
						<div class="relative aspect-[16/10] overflow-hidden rounded-xl bg-ink-raise">
							{item.data.cover && <Image src={item.data.cover} alt={`${item.data.title} — lokasi ${item.data.location}`} width={800} height={500} loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" />}
						</div>
						<div class="flex flex-1 flex-col pt-5">
							<p class="text-sm text-cream-dim">{item.data.location} · {item.data.date.getFullYear()}</p>
							<h3 class="mt-3 text-xl font-semibold leading-snug text-cream transition-colors group-hover:text-brand-teal">{item.data.title}</h3>
							<p class="mb-5 mt-3 line-clamp-2 text-base leading-relaxed text-cream-dim">{item.data.excerpt}</p>
							<span class="mt-auto font-semibold text-brand-teal">Baca Cerita <span aria-hidden="true">↗</span></span>
						</div>
					</a>
				))}
			</div>
		</section>
	)}

	<!-- Satu ajakan penutup dengan langkah berikutnya yang konkret. -->
	<section class="container-skala pb-16 lg:pb-20" aria-labelledby="kemitraan-title">
		<div class="relative overflow-hidden rounded-2xl bg-olive px-6 py-12 sm:p-12 lg:p-16" data-reveal-group>
			<DecoRidge class="pointer-events-none absolute bottom-0 left-0 w-full" />
			<div class="relative z-10 flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
				<div class="max-w-2xl" data-reveal>
					<span class="mb-6 block h-1 w-12 rounded-full bg-brand-gold" aria-hidden="true"></span>
					<h2 id="kemitraan-title" class="font-serif text-3xl font-semibold leading-tight text-white sm:text-4xl lg:text-5xl">Mari mulai dari kebutuhan di lapangan.</h2>
					<p class="mt-5 text-base leading-relaxed text-white/90">
						Punya rencana program CSR, pemberdayaan, atau konservasi? Sampaikan lokasi, tujuan,
						dan kebutuhan Anda untuk mendiskusikan ruang kerja sama bersama SKALA.
					</p>
				</div>
				<div class="shrink-0" data-reveal><CTAButton href="/kemitraan" variant="hero">Diskusikan Program</CTAButton></div>
			</div>
		</div>
	</section>
</Layout>
