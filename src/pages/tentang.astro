							<span class="font-serif text-7xl font-semibold text-cream/25">{person.initials}</span>
						</div>
					)}
					<div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/60 to-transparent"></div>
					<div class="absolute inset-x-4 bottom-4 z-[1] flex items-center justify-between gap-4 rounded-2xl bg-white/15 p-2 pl-6 shadow-[inset_0_2px_rgb(255_255_255/0.2)] backdrop-blur-md">
