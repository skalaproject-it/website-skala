								<rect width="4" height="12" x="2" y="9" />
								<circle cx="4" cy="4" r="2" />
							</svg>
							<svg
								class="pointer-events-none absolute h-[18px] w-[18px] opacity-0 transition-opacity duration-300 group-hover/socmed:opacity-100"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
							>
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
							</svg>
						</a>
					</div>
				</div>
			))}
		</div>
	</section>
</Layout>

<script>
	document.addEventListener('click', (event) => {
		const root = (event.target as HTMLElement).closest('[data-about-tabs]');
		if (!root) return;
		const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tab-btn]');
		if (!btn) return;
		const index = [...root.querySelectorAll('[data-tab-btn]')].indexOf(btn);
		root.querySelectorAll('[data-tab-btn]').forEach((tab, i) => {
			const active = i === index;
			tab.setAttribute('aria-selected', String(active));
			(tab as HTMLElement).dataset.active = String(active);
			(tab as HTMLElement).className = active
				? 'w-full border-b-[2.5px] border-olive pb-3 text-left font-serif text-lg font-medium text-olive transition-colors duration-200'
				: 'w-full border-b-[2.5px] border-transparent pb-3 text-left font-serif text-lg font-medium text-cream-dim transition-colors duration-200';
		});
		root.querySelectorAll('[data-tab-pane]').forEach((pane, i) => {
			pane.classList.toggle('hidden', i !== index);
		});
	});
</script>