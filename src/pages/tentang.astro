							class="group/socmed relative grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white/15 text-white shadow-[inset_0_2px_rgb(255_255_255/0.2)] transition-colors duration-300 hover:bg-white/25 focus-visible:bg-white/25"
						>
							<svg
								class="h-[18px] w-[18px] transition-opacity duration-300 group-hover/socmed:opacity-0"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
