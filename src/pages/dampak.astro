---
import Layout from '../layouts/Layout.astro';
import { Image, getImage } from 'astro:assets';
import PageHero from '../components/PageHero.astro';
import DecoRidge from '../components/DecoRidge.astro';
import EyebrowTag from '../components/EyebrowTag.astro';
import CTAButton from '../components/CTAButton.astro';
import { getCollection } from 'astro:content';
import { statusLabel, fmtArea } from '../utils/project';
import {
	photos,
	type PhotoKey,
} from '../utils/photos';

const projects = (await getCollection('projects')).sort((a, b) => a.id.localeCompare(b.id));

const monitoringRows = projects.map((project) => ({
	id: project.id,
	name: project.data.title,
	location: project.data.location,
	area: fmtArea(project.data.area_hectares),
	status: statusLabel[project.data.status],
}));

/* Belum ada hasil pengukuran resmi dari lapangan. Daripada menampilkan angka
   monitoring yang belum dapat dipertanggungjawabkan, halaman ini menyatakan
   status program apa adanya. */
const monitoringStatement =
	'Program konservasi di Garut masih pada tahap mencari mitra pendanaan, dan program CSR di Kamojang serta Ulubelu berada pada tahap pemetaan dan pendampingan awal. Data kuantitatif monitoring (luas tertanam, tingkat hidup bibit) akan ditampilkan di halaman ini setelah hasil pengukuran resmi tersedia dari lapangan.';

const gallery: { label: string; area: string; caption: string; photo: PhotoKey; alt: string }[] = [
	{
		label: 'Penanaman pohon bersama komunitas',
		area: 'Perhutanan sosial Desa Padaawas, Kabupaten Garut',
		caption: 'Hari Bumi 2026',
		photo: 'tanamBersama',
		alt: 'Warga menanam pohon bersama di lahan perhutanan sosial Desa Padaawas, Kabupaten Garut',
	},
	{
		label: 'Persemaian kebun bibit desa',
		area: 'Kabupaten Garut, Jawa Barat',
		caption: 'Persiapan musim tanam',
		photo: 'semaiTeras',
		alt: 'Barisan bibit pohon di persemaian desa untuk program reboisasi Kabupaten Garut',
	},
	{
		label: 'Rapat masyarakat bersama warga',
		area: 'Desa Padaawas dan Karyamekar, Kabupaten Garut',
		caption: 'Tata kelola CSR/TJSL',
		photo: 'rapatMasyarakat',
		alt: 'Ilustrasi musyawarah warga desa dalam kegiatan rapat masyarakat bersama tim SKALA',
	},
	{
		label: 'Pendampingan usaha kelompok desa',
		area: 'Ulubelu, Kabupaten Tanggamus, Lampung',
		caption: 'Ekonomi lokal',
		photo: 'umkmTenun',
		alt: 'Anggota kelompok usaha desa di Ulubelu, Kabupaten Tanggamus, Lampung, saat pendampingan produksi',
	},
	{
		label: 'Pemetaan sosial lapangan',
		area: 'Kecamatan Pasirwangi, Kabupaten Garut',
		caption: 'Social mapping',
		photo: 'penelitianLapangan',
		alt: 'Tim SKALA melakukan pemetaan sosial bersama warga di Kecamatan Pasirwangi, Kabupaten Garut',
	},
];

const pageTitle = 'Dampak & Transparansi — SKALA | Monitoring Program Berbasis Data';
const pageDescription =
	'Status monitoring program Yayasan Studi Komunitas Alamiah (SKALA) di Garut dan Lampung — data lapangan yang transparan dan dapat diverifikasi mitra.';

/* og:image memakai foto hero halaman ini, konsisten dengan /program dan /publikasi. */
const ogImage = await getImage({
	src: photos.hutanJabar,
	width: 1200,
	height: 630,
	fit: 'cover',
	format: 'jpeg',
});
const ogImageUrl = new URL(ogImage.src, Astro.site).toString();
---

<Layout title={pageTitle} description={pageDescription} image={ogImageUrl}>
	<!-- Hero -->
	<PageHero image={photos.hutanJabar} alt="Pemandangan udara kawasan hutan hijau di Jawa Barat, Indonesia" position="center 40%">
		<h1 class="hero-title" data-reveal>
			Dampak yang Diukur, Bukan Diklaim
		</h1>
		<p class="hero-lead" data-reveal>
			Status program, data lapangan yang dapat diverifikasi, serta catatan tentang apa yang belum tersedia —
			semuanya kami tampilkan terbuka.
		</p>
	</PageHero>

	<!-- Ringkasan angka -->
	<section class="container-skala py-20 lg:py-24" data-reveal-group>
		<EyebrowTag text="Ringkasan Monitoring" />
		<h2 class="mt-6 font-serif text-[30px] font-semibold leading-[1.2] text-olive sm:text-[42px] lg:text-[50px] xl:text-[56px]" data-reveal>
			Angka yang bisa dipertanggungjawabkan
		</h2>
		<p class="mt-4 max-w-2xl text-sm leading-[1.5] text-cream/65 sm:text-base sm:leading-[1.7]" data-reveal>
			{monitoringStatement}
		</p>

		<div class="mt-10 rounded-2xl bg-ink-card p-6 sm:p-8" data-reveal>
			<div class="overflow-x-auto rounded-2xl bg-white">
				<table class="w-full min-w-[640px] text-left">
					<thead>
						<tr class="border-b border-ink-rule text-[10px] font-semibold uppercase tracking-[0.18em] text-cream-dim">
							<th class="px-6 py-4">Kawasan</th>
							<th class="px-6 py-4">Lokasi</th>
							<th class="px-6 py-4">Luas</th>
							<th class="px-6 py-4">Status</th>
						</tr>
					</thead>
					<tbody>
						{monitoringRows.map((row) => (
							<tr class="border-b border-black/5 last:border-b-0">
								<td class="px-6 py-4">
									<a href={`/program/${row.id}`} class="text-sm font-semibold text-cream hover:text-olive-soft">{row.name}</a>
								</td>
								<td class="px-6 py-4 text-sm text-cream/60">{row.location}</td>
								<td class="px-6 py-4 text-sm tabular-nums text-cream/60">{row.area}</td>
								<td class="px-6 py-4 text-sm text-cream/70">{row.status}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
		<p class="mt-4 text-xs leading-[1.5] text-cream-dim" data-reveal>
			Status dan luas lahan setiap program mengikuti dokumen kerja serta arahan resmi mitra. Angka monitoring
			kuantitatif akan ditambahkan pada halaman ini setelah hasil pengukuran resmi tersedia dari lapangan.
		</p>
	</section>

	<!-- Dokumentasi -->

	<section class="container-skala pb-20 lg:pb-24" data-reveal-group>
		<EyebrowTag text="Dokumentasi Lapangan" />
		<h2 class="mt-6 font-serif text-[30px] font-semibold leading-[1.2] text-olive sm:text-[42px] lg:text-[50px] xl:text-[56px]" data-reveal>
			Foto kegiatan dan monitoring per kawasan
		</h2>

		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{gallery.map((photo) => (
				<figure class="group overflow-hidden rounded-2xl bg-ink-card" data-reveal>
					<div class="relative aspect-[4/3] w-full overflow-hidden bg-ink-raise">
						<Image
							src={photos[photo.photo]}
							alt={photo.alt}
							width={800}
							height={600}
							loading="lazy"
							decoding="async"
							class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
						/>
						<span class="absolute left-4 top-4 rounded-full bg-ink/85 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-white/85 backdrop-blur">
							Dokumentasi lapangan
						</span>
					</div>
					<figcaption class="p-5">
						<h3 class="font-serif text-lg text-cream">{photo.label}</h3>
						<p class="mt-1 text-xs font-semibold uppercase tracking-[0.16em] text-cream-dim">{photo.area} · {photo.caption}</p>
					</figcaption>
				</figure>
			))}
		</div>

		<div class="relative mt-12 flex flex-col items-start justify-between gap-6 overflow-hidden rounded-2xl bg-olive p-8 text-ink sm:flex-row sm:items-center lg:p-10" data-reveal>
			<DecoRidge class="pointer-events-none absolute bottom-0 left-0 w-full" />
			<div class="relative z-10">
				<p class="font-sans text-[1rem] font-semibold leading-[1.4] sm:text-[1.5rem]">
					Lihat data monitoring lengkap per program
				</p>
				<p class="mt-2 max-w-xl text-sm leading-[1.5] text-ink/75">
					Laporan monitoring detail, foto geotagged, dan protokol pengukuran dibuka untuk mitra pendanaan.
				</p>
			</div>
    <CTAButton href="/program" variant="outline" className="relative z-10 bg-ink text-cream hover:bg-ink-raise hover:text-cream">
				Telusuri Program
			</CTAButton>
		</div>
	</section>
</Layout>