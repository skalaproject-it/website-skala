---
interface Props {
	className?: string;
	/**
	 * Permukaan tempat motif garis kontur diletakkan. `dark` = panel gelap
	 * (default, gaya asli). `light` = panel terang. `olive` = panel olive.
	 */
	tone?: 'dark' | 'light' | 'olive';
	/**
	 * Cara motif mengisi kotaknya. `meet` = seluruh motif terlihat, kotak
	 * menyisakan ruang kosong bila rasionya beda (default, gaya asli).
	 * `slice` = motif menutupi kotak penuh dan memotong sisanya — wajib untuk
	 * latar bleed (inset-0), bukan untuk aksen sudut.
	 */
	fit?: 'meet' | 'slice';
}

const { class: className = '', tone = 'dark', fit = 'meet' } = Astro.props;
