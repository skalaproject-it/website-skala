---
// Isolasi simbol dari logo asli; warna dan bentuk artwork tetap utuh.
---
<span class="brand-mark">
	<svg class="brand-mark__symbol" viewBox="4 4 90 82" aria-hidden="true" focusable="false">
		<image href="/skala-logo.svg" width="232.5" height="90" />
	</svg>
	<span class="brand-mark__type">
		<span class="brand-mark__name">SKALA</span>
		<span class="brand-mark__subtitle">Studi Komunitas Alamiah</span>
	</span>
</span>

<style>
	.brand-mark { display: inline-flex; align-items: center; gap: 0.65rem; color: inherit; }
	.brand-mark__symbol { width: 44px; height: 44px; flex-shrink: 0; overflow: hidden; }
	.brand-mark__type { display: flex; flex-direction: column; gap: 3px; }
	.brand-mark__name { font-size: 1.4rem; font-weight: 800; letter-spacing: 0.12em; line-height: 1; }
	.brand-mark__subtitle { font-size: 0.625rem; line-height: 1.3; letter-spacing: 0.015em; }
</style>
