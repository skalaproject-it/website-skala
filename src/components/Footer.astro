---
import BrandMark from './BrandMark.astro';
const year = new Date().getFullYear();
---

<footer class="bg-ink-deep text-white">
	<div class="container-skala py-16 lg:py-[68px]">
		<div class="grid gap-14 lg:grid-cols-[1.1fr_1.5fr] lg:gap-20">
			<div class="max-w-md">
				<a href="/" class="inline-flex items-center" aria-label="SKALA — Beranda">
					<BrandMark />
				</a>
				<p class="mt-5 text-sm font-light leading-[1.5] text-white/60">
					Mendampingi komunitas, memperkuat kemandirian masyarakat, dan merawat alam melalui program bersama mitra.
				</p>

				<form data-newsletter-form class="mt-8">
					<p class="text-sm font-light text-white/70">Dapatkan kabar terbaru dari lapangan.</p>
					<div class="mt-4 flex max-w-md items-center gap-3">
						<input
							id="newsletter-email"
							type="email"
							name="email"
							required
							placeholder="email@contoh.id"
							class="h-12 w-full rounded-full border border-white/25 bg-transparent px-6 text-sm text-white placeholder:text-white/40 focus:border-olive-soft focus:outline-none"
						/>
						<button
							type="submit"
							class="h-12 shrink-0 rounded-full bg-olive px-6 text-sm font-semibold text-ink transition-colors duration-300 hover:bg-olive-soft"
						>
							Kirim
						</button>
					</div>
					<p data-newsletter-status class="mt-3 hidden text-xs font-medium text-white/80">
						Terima kasih! Pendaftaran Anda telah diterima.
					</p>
				</form>
			</div>

			<div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
				<nav aria-label="Menu">
					<h3 class="text-sm font-semibold">Menu</h3>
					<ul class="mt-6 space-y-4">
						{[
							{ label: 'Beranda', href: '/' },
							{ label: 'Tentang', href: '/tentang' },
    { label: 'Program', href: '/program' },
							{ label: 'Publikasi', href: '/publikasi' },
							{ label: 'Berita', href: '/berita' },
							{ label: 'Kontak', href: '/kontak' },
						].map((link) => (
							<li>
								<a
									href={link.href}
									class="text-sm font-light text-white/60 transition-colors duration-200 hover:text-white"
								>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</nav>

				<nav aria-label="Tentang">
					<h3 class="text-sm font-semibold">Organisasi</h3>
					<ul class="mt-6 space-y-4">
						{[
							{ label: 'Tentang Kami', href: '/tentang' },
							{ label: 'Metodologi & Sains', href: '/metodologi' },
							{ label: 'Tata Kelola', href: '/tata-kelola' },
							{ label: 'Komunitas & Mitra KTH', href: '/komunitas' },
							{ label: 'Dampak', href: '/dampak' },
							{ label: 'Kemitraan', href: '/kemitraan' },
						].map((link) => (
							<li>
								<a
									href={link.href}
									class="text-sm font-light text-white/60 transition-colors duration-200 hover:text-white"
								>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</nav>

				<div>
					<h3 class="text-sm font-semibold">Kontak</h3>
					<address class="mt-6 not-italic">
						<p class="text-sm font-semibold text-white">Yayasan Studi Komunitas Alamiah (SKALA)</p>
						<ul class="mt-4 space-y-4 text-sm font-light text-white/60">
							<li>
								<a
									href="mailto:office@skalapro.or.id"
									class="flex items-center gap-3 transition-colors duration-200 hover:text-white"
								>
									<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<rect x="2" y="4" width="20" height="16" rx="2" />
										<path d="m22 7-10 6L2 7" />
									</svg>
									office@skalapro.or.id
								</a>
							</li>
							<li>
								<a
									href="tel:+6287878638940"
									class="flex items-center gap-3 transition-colors duration-200 hover:text-white"
								>
									<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
									</svg>
									0878-7863-8940
								</a>
							</li>
							<li class="flex items-start gap-3 leading-[1.5]">
								<svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M20 10c0 4.99-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 14.99 4 10a8 8 0 0 1 16 0Z" />
									<circle cx="12" cy="10" r="3" />
								</svg>
								Jl. Panawuan No. 5A, Kel. Sukajaya, Kec. Tarogong Kidul, Kab. Garut, Jawa Barat 44152
							</li>
						</ul>
					</address>

					<div class="mt-8 flex gap-3">
						{[
							{
								label: 'Instagram',
								paths: '<path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9s.7.8.9 1.4c.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4s-.8.7-1.4.9c-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9s-.7-.8-.9-1.4c-.2-.4-.4-1-.4-2.2-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4s.8-.7 1.4-.9c.4-.2 1-.4 2.2-.4 1.3-.1 1.7-.1 4.9-.1Z" /><circle cx="12" cy="12" r="5" /><path d="M17.2 6.8a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" />',
							},
							{
								label: 'Facebook',
								paths: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />',
							},
							{
								label: 'YouTube',
								paths: '<path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z" />',
							},
							{
								label: 'X',
								paths: '<path d="M4 4 20 20" /><path d="M20 4 4 20" />',
							},
						].map((social) => (
							<a
								key={social.label}
								href="#"
								class="grid h-10 w-10 place-items-center rounded-full bg-white text-ink-deep transition-colors duration-300 hover:bg-ink-raise"
								aria-label={social.label}
							>
								<svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={social.paths}></svg>
							</a>
						))}
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="border-t border-white/10">
		<div class="container-skala flex flex-col items-center justify-between gap-3 py-6 text-xs font-light text-white/70 sm:flex-row">
			<p>© {year} SKALA. Seluruh hak cipta dilindungi.</p>
			<p>Dua dekade mendampingi komunitas, membangun kemandirian yang bertahan.</p>
		</div>
	</div>
</footer>

<script>
	document.addEventListener('submit', (event) => {
		const form = (event.target as HTMLElement).closest<HTMLFormElement>('[data-newsletter-form]');
		if (!form) return;
		event.preventDefault();
		const status = form.querySelector<HTMLElement>('[data-newsletter-status]');
		if (status) status.classList.remove('hidden');
		const input = form.querySelector<HTMLInputElement>('input[type="email"]');
		if (input) input.value = '';
	});
</script>
