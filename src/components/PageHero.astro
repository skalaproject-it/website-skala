---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image: ImageMetadata;
	alt: string;
	position?: string;
	/** Optional override. Defaults follow the reference inner header heights. */
	minHeight?: string;
	/** Renders the eyebrow row directly above the heading, centred. */
	eyebrow?: string;
}

const {
	image,
	alt,
	position = 'center',
	minHeight = 'min-h-[420px] min-[480px]:min-h-[480px] min-[992px]:min-h-[540px] min-[1280px]:min-h-[480px]',
	eyebrow,
} = Astro.props;
---

<section class:list={['relative flex items-end overflow-hidden bg-ink-deep', minHeight]}>
	<div class="absolute inset-0" aria-hidden="true">
		<Image
			src={image}
			alt={alt}
			width={1920}
			height={1080}
			loading="eager"
			fetchpriority="high"
			decoding="async"
			class="absolute inset-0 h-full w-full object-cover"
			style={`object-position: ${position}`}
		/>
		{/* Scrim: gradien gelap ke transparan di atas foto. Gradien bawah meniru
		    hero home (yang sudah fix) supaya transisi hero ke body seamless.
		    Catatan: jangan pakai z-index negatif di sini. <section> tidak
		    membentuk stacking context, sehingga anak dengan z-index < 0 akan
		    ter-paint di belakang background section yang opaque, dan gradien
	    ini ikut hilang. Andalkan urutan DOM saja, seperti di home. */}
		<div class="pointer-events-none absolute inset-0" aria-hidden="true">
			<div
				class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-ink-deep/85 via-ink-deep/35 to-transparent sm:h-48 lg:h-56"
			>
			</div>
			<div
				class="absolute inset-x-0 bottom-0 h-64 bg-gradient-to-b from-transparent to-ink-deep sm:h-80 lg:h-[400px] min-[1440px]:h-[450px] min-[1920px]:h-[500px]"
			>
			</div>
		</div>
	</div>

	<div
		class="container-skala relative w-full pt-28 pb-16 min-[480px]:pb-[100px] min-[992px]:pt-32 min-[992px]:pb-[120px]"
		data-hero-drop
		data-reveal-group
		data-reveal-stagger="120"
	>
		<div class="flex flex-col items-center gap-4 text-center">
			{
				eyebrow && (
					<p class="hero-eyebrow" data-reveal>
						{eyebrow}
					</p>
				)
			}
			<slot />
		</div>
	</div>
</section>
